# =============================================================================
# Industrial AI Vision & Safety Intelligence Platform — environment template
# Copy to `.env` for local development. Never commit real credentials.
#   copy .env.example .env   (Windows: copy .env.example .env)
# =============================================================================

# --- Application ---
APP_NAME=industrial-vision-platform
APP_ENV=development
# development | testing | production
LOG_LEVEL=INFO
# DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Database (PostgreSQL-ready; V01 uses lazy/async-safe checks, no hard dependency) ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/industrial_vision

# --- Cache / realtime state (Redis-ready) ---
REDIS_URL=redis://localhost:6379/0

# --- AI / Model (V03 live inference) ---
GPU_ENABLED=false
MODEL_NAME=yolo11n
MODEL_PATH=models/yolo11n.pt
MODEL_DEVICE=auto
# auto | cpu | cuda (auto falls back to CPU when CUDA is unavailable)
MODEL_CONFIDENCE_THRESHOLD=0.5
MODEL_IOU_THRESHOLD=0.45
MODEL_IMAGE_SIZE=640
MODEL_MAX_DETECTIONS=300
# Optional class allowlist, e.g. MODEL_CLASSES=person,car; empty = all classes
MODEL_CLASSES=

# --- Realtime ---
WEBSOCKET_ENABLED=true

# --- V02 video ingestion ---
TARGET_PROCESSING_FPS=10.0
FRAME_SKIP=0
BUFFER_SIZE=30

# --- V04 tracking (native ByteTrack-compatible) ---
TRACK_MIN_HITS=3
TRACK_MAX_AGE=30
TRACK_IOU_THRESHOLD=0.3
TRACK_HISTORY_SIZE=30
TRACK_HIGH_CONF=0.5

# --- V05 safety intelligence (deterministic geometry rules) ---
SAFETY_ENABLED=true
SAFETY_FALL_ASPECT_RATIO_THRESHOLD=1.2
SAFETY_FALL_PERSISTENCE_FRAMES=5
SAFETY_CROWD_WARNING_COUNT=5
SAFETY_CROWD_CRITICAL_COUNT=10
SAFETY_PROXIMITY_IOU_THRESHOLD=0.05
SAFETY_PROXIMITY_CENTER_DISTANCE_RATIO=0.3
SAFETY_STATIONARY_SPEED_THRESHOLD=15.0
SAFETY_STATIONARY_DURATION_SECONDS=10.0
SAFETY_EVENT_RESOLUTION_GRACE_SECONDS=3.0
SAFETY_MAX_EVENTS_PER_CAMERA=100

# --- V06 spatial safety (image-space zones + proximity) ---
SPATIAL_ENABLED=true
SPATIAL_DEFAULT_DWELL_SECONDS=5.0
SPATIAL_PROXIMITY_STRATEGY=HYBRID
# CENTER_DISTANCE | IOU | HYBRID
SPATIAL_PROXIMITY_IOU_THRESHOLD=0.05
SPATIAL_PERSON_VEHICLE_ENABLED=true
SPATIAL_PERSON_VEHICLE_THRESHOLD=0.3
SPATIAL_PERSON_VEHICLE_SEVERITY=HIGH
SPATIAL_PERSON_PERSON_ENABLED=false
SPATIAL_PERSON_PERSON_THRESHOLD=0.25
SPATIAL_PERSON_PERSON_SEVERITY=MEDIUM
SPATIAL_VEHICLE_VEHICLE_ENABLED=false
SPATIAL_VEHICLE_VEHICLE_THRESHOLD=0.25
SPATIAL_VEHICLE_VEHICLE_SEVERITY=LOW
SPATIAL_MAX_ZONES_PER_CAMERA=20
SPATIAL_STATE_GRACE_SECONDS=5.0

# --- V07 quality inspection (framework; no specialized defect weights) ---
# V07 provides the inspection framework (profiles, regions, defect categories,
# decision policy, events). It does NOT claim generic detectors find defects.
QUALITY_ENABLED=true
# Named inspection model. Empty = INSPECTION_MODEL_NOT_CONFIGURED: an inspection
# attempt then decides ERROR (never PASS). "fixture" resolves the scripted
# test adapter OUTSIDE production only.
QUALITY_INSPECTION_MODEL=
QUALITY_INSPECTION_INTERVAL_FRAMES=5
QUALITY_MAX_PROFILES_PER_CAMERA=10
QUALITY_MAX_REGIONS_PER_PROFILE=20
QUALITY_MAX_OBSERVATIONS_PER_INSPECTION=50
QUALITY_MAX_RESULTS_PER_CAMERA=30
QUALITY_MAX_EVENTS_PER_CAMERA=100
QUALITY_EVENT_RESOLUTION_GRACE_SECONDS=3.0
QUALITY_DEFAULT_CONFIDENCE_THRESHOLD=0.6
QUALITY_DEFAULT_REVIEW_THRESHOLD=0.35
QUALITY_DEFAULT_FAIL_SEVERITIES=HIGH,CRITICAL
# REVIEW | FAIL | IGNORE
QUALITY_MISSING_EVIDENCE_BEHAVIOR=REVIEW
# RECORD_ERROR | SKIP
QUALITY_INSPECTION_ERROR_BEHAVIOR=RECORD_ERROR

# --- V08 autonomous perception (relative scene understanding; no metric claims) ---
# V08 provides an autonomous-perception foundation: scene representation,
# perceived objects, lanes, relative motion, trajectories, collision-risk
# analysis, and a relative bird's-eye view. It is NOT a certified
# autonomous-driving or ADAS safety system: no meters, no certified TTC.
AUTONOMOUS_ENABLED=true
# Named model adapters. Empty = NOT_CONFIGURED (subsystem reports unavailable,
# rest of perception continues). "fixture" resolves scripted test adapters
# OUTSIDE production only.
AUTONOMOUS_SCENE_CLASSIFIER=
AUTONOMOUS_LANE_DETECTOR=
AUTONOMOUS_DEPTH_MODEL=
AUTONOMOUS_LANE_DETECTION_ENABLED=true
AUTONOMOUS_DEPTH_ENABLED=false
AUTONOMOUS_TRAJECTORY_ENABLED=true
AUTONOMOUS_COLLISION_RISK_ENABLED=true
AUTONOMOUS_BEV_ENABLED=true
AUTONOMOUS_PERCEPTION_INTERVAL_FRAMES=10
AUTONOMOUS_TRAJECTORY_HORIZON_SECONDS=2.0
AUTONOMOUS_TRAJECTORY_HISTORY_POINTS=8
AUTONOMOUS_COLLISION_GRACE_SECONDS=0.5
AUTONOMOUS_COLLISION_RISK_THRESHOLD=0.5
AUTONOMOUS_MAX_OBJECTS_PER_SCENE=100
AUTONOMOUS_MAX_RESULTS_PER_CAMERA=30
AUTONOMOUS_MAX_EVENTS_PER_CAMERA=100
AUTONOMOUS_MAX_PROFILES_PER_CAMERA=10
AUTONOMOUS_MOTION_SPEED_THRESHOLD=0.02
AUTONOMOUS_APPROACH_AREA_RATIO=0.02

# --- V09 event & risk intelligence (operational heuristics, not probabilities) ---
# V09 correlates V05/V06/V07/V08 events into unified risk clusters with
# explainable risk factors. Scores are normalized operational heuristics.
INTELLIGENCE_ENABLED=true
RISK_LOW_THRESHOLD=0.20
RISK_MEDIUM_THRESHOLD=0.40
RISK_HIGH_THRESHOLD=0.65
RISK_CRITICAL_THRESHOLD=0.85
EVENT_CORRELATION_WINDOW_SECONDS=5.0
EVENT_RESOLUTION_GRACE_SECONDS=2.0
RISK_BASE_SCORE=0.10
RISK_SEVERITY_WEIGHT=0.35
RISK_PERSISTENCE_WEIGHT=0.15
RISK_CORRELATION_WEIGHT=0.25
RISK_CONFIDENCE_WEIGHT=0.15
INTELLIGENCE_MAX_EVENTS_PER_CAMERA=200
INTELLIGENCE_MAX_CLUSTERS_PER_CAMERA=50

# --- V10 incident management (operational records, PostgreSQL-backed) ---
# P0/P1/P2 clusters auto-create incidents by default; P3/P4 do not unless
# INCIDENT_MIN_PRIORITY is lowered. Auto-resolve only moves OPEN incidents
# to RESOLVED (AUTOMATIC_CLEAR) — never closes anything.
INCIDENTS_ENABLED=true
INCIDENT_MIN_PRIORITY=P2
INCIDENT_AUTO_RESOLVE_ENABLED=true
INCIDENT_AUTO_RESOLVE_GRACE_SECONDS=30
INCIDENT_TIMELINE_UPDATE_THRESHOLD_SECONDS=5

# --- V11 backend hardening ---
# Explicit origins per environment. Wildcard + credentials is rejected in
# EVERY environment; production additionally rejects wildcard origins and
# requires at least one explicit origin. Invalid CORS fails startup.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Credentials require explicit origins (wildcard + credentials is rejected
# in every environment). The frontend uses plain fetch without credentials.
CORS_ALLOW_CREDENTIALS=false
WORKER_HEARTBEAT_TIMEOUT_SECONDS=30
WEBSOCKET_QUEUE_MAX_SIZE=100
WEBSOCKET_HEARTBEAT_TIMEOUT_SECONDS=60
WEBSOCKET_SHUTDOWN_TIMEOUT_SECONDS=5
MAX_REQUEST_BODY_BYTES=1048576

# --- V12 PostgreSQL reliability ---
# Pool knobs apply to server databases (SQLite dev/test path unchanged).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10

# --- V12 Redis + event bus ---
# Local single-process delivery is the default. Distributed mode requires
# Redis explicitly and never silently falls back to local-only.
# No real secrets here: REDIS_URL is a placeholder without credentials.
REDIS_ENABLED=false
REDIS_REQUIRED=false
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5
EVENT_BUS_MODE=local
EVENT_BUS_CHANNEL=ivp:events/v1
EVENT_MAX_PAYLOAD_BYTES=65536
EVENT_QUEUE_MAX=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_BASE_SECONDS=5
OPERATIONAL_EVENT_RETENTION_DAYS=90

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
