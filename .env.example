# =============================================================================
# Industrial AI Vision & Safety Intelligence Platform — environment template
# Copy to `.env` for local development. Never commit real credentials.
#   copy .env.example .env   (Windows: copy .env.example .env)
# =============================================================================

# --- Application ---
APP_NAME=industrial-vision-platform
APP_ENV=development
# development | testing | production
LOG_LEVEL=INFO
# DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Database (PostgreSQL-ready; V01 uses lazy/async-safe checks, no hard dependency) ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/industrial_vision

# --- Cache / realtime state (Redis-ready) ---
REDIS_URL=redis://localhost:6379/0

# --- AI / Model (V01: configuration only; inference lands in later volumes) ---
GPU_ENABLED=false
MODEL_DEVICE=cpu
# cpu | cuda | cuda:0 ...
MODEL_CONFIDENCE_THRESHOLD=0.5

# --- Realtime ---
WEBSOCKET_ENABLED=true

# --- V02 video ingestion ---
TARGET_PROCESSING_FPS=10.0
FRAME_SKIP=0
BUFFER_SIZE=30

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
