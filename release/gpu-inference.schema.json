{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luccy93/Industrial-Vision-Platform-Developmentr/release/gpu-inference.schema.json",
  "title": "Industrial Vision Platform GPU inference report",
  "description": "Container-level GPU inference evidence produced by tools/release/inference.py. The digest-pinned api-gpu image is run with --gpus all and the structured smoke test must report READY on a CUDA device. A non-executed run is NOT_RUN; missing Docker, a non-zero exit, malformed JSON, CPU fallback, or a skipped model never becomes PASS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "executed",
    "manifest_sha256",
    "subject",
    "image",
    "digest",
    "state",
    "verified",
    "runtime",
    "checks",
    "blockers",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "executed": {
      "type": "boolean"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/digest"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "image": {
      "type": ["string", "null"]
    },
    "digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "verified": {
      "type": "boolean"
    },
    "runtime": {
      "oneOf": [
        {
          "$ref": "#/$defs/runtime"
        },
        {
          "type": "null"
        }
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "state": {
      "enum": ["PASS", "FAIL", "NOT_RUN", "UNAVAILABLE", "SIMULATED"]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit", "source_repository"],
      "properties": {
        "tag": {
          "type": ["string", "null"]
        },
        "commit": {
          "type": ["string", "null"]
        },
        "source_repository": {
          "type": ["string", "null"]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "model",
        "requested_device",
        "device",
        "cuda",
        "latency_ms",
        "detections",
        "classes",
        "reason"
      ],
      "properties": {
        "status": {
          "type": ["string", "null"]
        },
        "model": {
          "type": ["string", "null"]
        },
        "requested_device": {
          "type": ["string", "null"]
        },
        "device": {
          "type": ["string", "null"]
        },
        "cuda": {
          "type": ["object", "null"]
        },
        "latency_ms": {
          "type": ["number", "null"]
        },
        "detections": {
          "type": ["integer", "null"]
        },
        "classes": {
          "type": ["integer", "null"]
        },
        "reason": {
          "type": ["string", "null"]
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "state", "required", "detail", "command"],
      "properties": {
        "name": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "required": {
          "type": "boolean"
        },
        "detail": {
          "type": "string"
        },
        "command": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
