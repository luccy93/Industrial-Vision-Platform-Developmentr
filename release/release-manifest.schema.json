{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luccy93/Industrial-Vision-Platform-Developmentr/release/release-manifest.schema.json",
  "title": "Industrial Vision Platform release manifest",
  "description": "Immutable release metadata generated by .github/workflows/release.yml. The authoritative validator is tools/release/manifest.py; this schema documents the shape for external consumers and is kept in sync by tests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "build", "images", "variants"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "commit",
        "source_repository",
        "workflow_run_url",
        "workflow_run_id",
        "workflow_run_attempt",
        "created_at"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "description": "Stable SemVer release tag; prereleases and build metadata are rejected."
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Full commit SHA the tag points at; must be reachable from origin/main."
        },
        "source_repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "description": "GitHub owner/repository that produced the release."
        },
        "workflow_run_url": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/actions/runs/[0-9]+$"
        },
        "workflow_run_id": {
          "type": "integer",
          "minimum": 1
        },
        "workflow_run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "event", "ref", "builder"],
      "properties": {
        "workflow": {
          "type": "string",
          "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"
        },
        "event": {
          "const": "push"
        },
        "ref": {
          "type": "string",
          "pattern": "^refs/tags/v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "builder": {
          "const": "docker build"
        }
      }
    },
    "images": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/image"
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu"],
      "properties": {
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image", "published", "runtime_smoke", "runtime_smoke_reason"],
          "properties": {
            "image": {
              "const": "api-gpu"
            },
            "published": {
              "const": true,
              "description": "Stable releases require a verified GPU image."
            },
            "runtime_smoke": {
              "enum": ["passed", "not_run"]
            },
            "runtime_smoke_reason": {
              "type": "string",
              "description": "Required when runtime_smoke is not_run (for example, no GPU infrastructure)."
            }
          }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Plain file name inside the release-artifacts directory."
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "sbom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "path", "sha256"],
      "properties": {
        "format": {
          "const": "spdx-json"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "severity", "ignore_unfixed", "result", "target", "log"],
      "properties": {
        "tool": {
          "const": "trivy"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "const": "CRITICAL,HIGH"
        },
        "ignore_unfixed": {
          "const": true
        },
        "result": {
          "const": "clean"
        },
        "target": {
          "const": "image"
        },
        "log": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism",
        "predicate_type",
        "attestation_url",
        "verification_command",
        "evidence"
      ],
      "properties": {
        "mechanism": {
          "const": "github-artifact-attestation"
        },
        "predicate_type": {
          "type": "string",
          "minLength": 1
        },
        "attestation_url": {
          "type": "string",
          "pattern": "^https://api\\.github\\.com/repos/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/attestations/sha256:[0-9a-f]{64}$"
        },
        "verification_command": {
          "type": "string",
          "pattern": "^gh attestation verify oci://.+@sha256:[0-9a-f]{64} --repo [A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+( --predicate-type .+)?$"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "repository",
        "digest",
        "tags",
        "image_id",
        "pulled_image_id",
        "platform",
        "size_bytes",
        "sbom",
        "scan",
        "provenance",
        "sbom_attestation"
      ],
      "properties": {
        "name": {
          "enum": ["api", "web", "api-gpu"]
        },
        "repository": {
          "type": "string",
          "pattern": "^ghcr\\.io/[a-z0-9_.-]+/[a-z0-9_.-]+/(api|web|api-gpu)$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "tags": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string"
          },
          "description": "Exactly the version tag and the commit-addressed sha-<short> tag."
        },
        "image_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pulled_image_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Image ID observed after pulling by digest; must equal image_id."
        },
        "platform": {
          "enum": ["linux/amd64", "linux/arm64"]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sbom": {
          "$ref": "#/$defs/sbom"
        },
        "scan": {
          "$ref": "#/$defs/scan"
        },
        "provenance": {
          "$ref": "#/$defs/attestation"
        },
        "sbom_attestation": {
          "$ref": "#/$defs/attestation"
        }
      }
    }
  }
}
