{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luccy93/Industrial-Vision-Platform-Developmentr/release/trust-state.schema.json",
  "title": "Industrial Vision Platform local evidence trust state",
  "description": "V31 local monotonic checkpoint reference used for replay and rollback detection. This file is tamper-evident but not independently protected: an attacker who can rewrite it can also rewrite the sequence it records. V31 reports reduced assurance unless a separately supplied external reference is verified.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "updated_at",
    "checkpoints",
    "state_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "const": "evidence_trust_state"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "checkpoints": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/checkpoint_reference"
      }
    },
    "state_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "checkpoint_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_report_id",
        "checkpoint_id",
        "checkpoint_sequence",
        "audit_record_count",
        "audit_chain_terminal_hash",
        "evidence_manifest_digest",
        "created_at",
        "key_id"
      ],
      "properties": {
        "evidence_report_id": {
          "type": "string",
          "pattern": "^report:sha256:[0-9a-f]{64}$"
        },
        "checkpoint_id": {
          "type": "string",
          "pattern": "^chk-[0-9a-f]{32}$"
        },
        "checkpoint_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "audit_record_count": {
          "type": "integer",
          "minimum": 1
        },
        "audit_chain_terminal_hash": {
          "$ref": "#/$defs/digest"
        },
        "evidence_manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        }
      }
    }
  }
}
