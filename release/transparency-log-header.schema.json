{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luccy93/Industrial-Vision-Platform-Developmentr/release/transparency-log-header.schema.json",
  "title": "Industrial Vision Platform transparency log header",
  "description": "V32 header for the first line of an append-only JSONL transparency log. The log stores checkpoint references and digests only; it never stores private keys, credentials, raw evidence, or external service tokens.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "log_id",
    "hash_algorithm",
    "merkle_algorithm",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "const": "evidence_transparency_log"
    },
    "log_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "hash_algorithm": {
      "const": "sha256"
    },
    "merkle_algorithm": {
      "const": "rfc6962-sha256-v1"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
