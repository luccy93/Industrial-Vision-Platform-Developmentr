{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luccy93/Industrial-Vision-Platform-Developmentr/release/transparency-log-entry.schema.json",
  "title": "Industrial Vision Platform transparency log entry",
  "description": "V32 checkpoint reference stored as one JSONL line after the header. entry_id is derived from the canonical entry fields; previous_entry_digest links the hash chain; checkpoint_digest is the SHA-256 of the full canonical V31 signed checkpoint document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "entry_index",
    "entry_id",
    "entry_type",
    "checkpoint_id",
    "checkpoint_sequence",
    "checkpoint_digest",
    "previous_entry_digest",
    "timestamp"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "const": "evidence_transparency_log_entry"
    },
    "entry_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999
    },
    "entry_id": {
      "type": "string",
      "pattern": "^tle-[0-9a-f]{32}$"
    },
    "entry_type": {
      "const": "CHECKPOINT_APPENDED"
    },
    "checkpoint_id": {
      "type": "string",
      "pattern": "^chk-[0-9a-f]{32}$"
    },
    "checkpoint_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "checkpoint_digest": {
      "$ref": "#/$defs/digest"
    },
    "previous_entry_digest": {
      "$ref": "#/$defs/digest"
    },
    "timestamp": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
