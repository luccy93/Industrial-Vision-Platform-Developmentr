{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luccy93/Industrial-Vision-Platform-Developmentr/release/staging-target.schema.json",
  "title": "Industrial Vision Platform controlled staging target",
  "description": "An explicit, named staging target consumed by tools/release/staging.py. The environment must be staging, the release binding must match the immutable manifest, and every URL must be HTTPS/WSS. Production targets are rejected before any command runs. The target never contains credentials; the smoke password is read from the named environment variable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "environment",
    "release",
    "api_url",
    "web_url",
    "ws_url",
    "smoke_username",
    "smoke_password_env",
    "compose_project",
    "compose_files",
    "gpu"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,62}$",
      "description": "Stable target name. This exact value must be supplied to --authorize before any mutation."
    },
    "environment": {
      "const": "staging"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "commit",
        "source_repository"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        }
      }
    },
    "api_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "web_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "ws_url": {
      "type": "string",
      "pattern": "^wss://"
    },
    "smoke_username": {
      "type": "string",
      "minLength": 1
    },
    "smoke_password_env": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "compose_project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
    },
    "compose_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gpu": {
      "type": "boolean"
    },
    "previous_manifest": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional previous release manifest used for migration compatibility and rollback rehearsal. Relative to the repository root."
    },
    "previous_verification_report": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional previous production verification report used only for an executed rollback rehearsal. Relative to the repository root."
    }
  }
}
